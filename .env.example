# Copy to .env and fill in. Never commit .env.

# ---- where it runs ----
PUBLIC_URL=https://bookmarks.harsh-agrawal.com     # exact public origin; X redirects back to PUBLIC_URL/auth/x/callback
PORT=8379                                          # host port on 127.0.0.1 (the tunnel points here)
APP_ENV=prod                                       # shown as a badge in the header; use "dev" on a test copy

# ---- Postgres ----
# Bundled container (default). To use an existing Postgres on Kamaji instead: delete the
# COMPOSE_PROFILES line and set DATABASE_URL (the database and role must already exist).
COMPOSE_PROFILES=bundled-db
POSTGRES_PASSWORD=change-me      # URL-safe, it is embedded in DATABASE_URL: `openssl rand -hex 24`
# DATABASE_URL=postgresql://okiedoke:PASSWORD@host.docker.internal:5432/okiedoke

# ---- X (official API) ----
# developer.x.com -> your app -> User authentication settings: OAuth 2.0, permissions "Read",
# callback URL = PUBLIC_URL + /auth/x/callback, then copy the keys here.
X_CLIENT_ID=
X_CLIENT_SECRET=                                   # leave empty if your X app is a public (PKCE-only) client
SECRET_KEY=                                        # encrypts the stored X tokens: `openssl rand -base64 32`. Keep it; losing it means reconnecting X.

# ---- sync behaviour (defaults shown) ----
# SYNC_ENABLED=true
# SYNC_INTERVAL_MIN=60        # background check for new bookmarks
# SYNC_COOLDOWN_MIN=10        # opening the page syncs unless one ran this recently
# FULL_SWEEP_DAYS=7           # weekly full re-read (refreshes counts, flags bookmarks removed from X); 0 = never
# INCREMENTAL_PAGE_SIZE=25    # X bills per post read: a quiet sync reads just this many
# LOG_LEVEL=INFO
